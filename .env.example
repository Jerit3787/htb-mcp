# Create an App Token at https://app.hackthebox.com/settings -> App Tokens.
HTB_TOKEN=

# Optional: browser session cookie. Used in addition to HTB_TOKEN when an
# endpoint rejects App Token auth. Keep this secret.
# HTB_SESSION_COOKIE=

# Optional overrides.
# HTB_LABS_URL=https://labs.hackthebox.com
# HTB_TIMEOUT_MS=30000
# HTB_MAX_RETRIES=2
# HTB_VPN_DIR=~/.config/htb-mcp/vpn
# HTB_DOWNLOAD_DIR=~/.config/htb-mcp/downloads
# HTB_DOWNLOAD_TIMEOUT_MS=300000
# HTB_OPENVPN_BIN=openvpn
# HTB_OPENVPN_USE_SUDO=1
